/target

# Local Claude Code state
.claude/

# Svelte/Vite build
web/node_modules/
web/.svelte-kit/
web/build/

# Embedded SPA build output — regenerated by `bun run build` (and by CI/Docker
# before the Rust build), so it's kept out of git. The directory itself must
# exist for rust-embed (`#[folder = "src/web-dist/"]`) to compile, hence the
# tracked .gitkeep.
/src/web-dist/*
!/src/web-dist/.gitkeep

# wshm runtime
.wshm/
*.log

# Local docker-compose secrets
.env

# OS
.DS_Store
*.swp
*.swo
